{
  "rewrites": [
    {
      "source": "/((?!assets/|images/|api/|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(assets|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|svg|webp|jpg|jpeg|mp4|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/categoria/florestal-fauna",
      "destination": "/blog/categoria/fauna-flora",
      "permanent": true
    },
    {
      "source": "/blog/categoria/residuos-solidos",
      "destination": "/blog/categoria/pgrs-residuos",
      "permanent": true
    },
    {
      "source": "/blog/resgate-fauna-supressao-vegetal-obras",
      "destination": "/blog/resgate-fauna-supressao-vegetal-requisitos-inema",
      "permanent": true
    },
    {
      "source": "/blog/inventario-florestal-asv-guia-completo",
      "destination": "/blog/inventario-florestal-asv-supressao-vegetal-segura",
      "permanent": true
    }
  ]
}
