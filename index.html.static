    <!-- footer / contato
    ================================================== -->
    <footer id="contato" class="s-footer h-dark-bg">

        <div class="right-vert-line"></div>

        <div class="row s-footer__main">
            <div class="column large-6">
                <div class="section-intro" data-aos="fade-up">
                    <h3 class="subhead">Contato</h3>

                    <h1 class="display-1">
                    Nos conte o projeto. A gente mapeia o que é preciso para o licenciamento avançar e apresenta proposta na medida.
                    </h1>
                </div>

                <div class="footer-email-us">
                    <a href="mailto:contato@anjosbrandao.eco.br" class="btn btn--primary h-full-width">Falar com consultor</a>
                </div>
            </div>

            <div class="column large-5">
                <div class="footer-contacts">
                    <div class="footer-contact-block" data-aos="fade-up">
